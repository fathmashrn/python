import numpy as np
import matplotlib.pyplot as plt

matrix_A = np.array([
    [1, 2],
    [3, 4]
])

matrix_B = np.array([
    [5, 6],
    [7, 8]
])

print("\nMatrix A:")
print(matrix_A)

print("\nMatrix B:")
print(matrix_B)

# Matrix multiplication
result = np.dot(matrix_A, matrix_B)

print("\nMatrix Multiplication:")
print(result)

# Transpose
print("\nTranspose of Matrix A:")
print(matrix_A.T)
