import pandas as pd
import seaborn as sns

df = sns.load_dataset("titanic")

# Ascending order
sorted_ascending = df.sort_values(by="fare", ascending=True)

print("\nFare in ascending order:")
print(sorted_ascending[["who", "fare"]].head(10))

# Descending order
sorted_descending = df.sort_values(by="fare", ascending=False)

print("\nFare in descending order:")
print(sorted_descending[["who", "fare"]].head(10))
